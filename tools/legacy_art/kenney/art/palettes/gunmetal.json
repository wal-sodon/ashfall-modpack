			"bottom": "#161719"
		},
		"chrome": {
			"top": "#d4d8de",
			"bottom": "#7d838c"
		},
		"accent_panel": {
			"top": "mix(#555a63,ACCENT,0.06)",
			"bottom": "mix(#292c32,ACCENT,0.04)",
			"glow": "ACCENT",
			"glow_band": [
				0.4,
				0.56
			]
		},
		"energy": {
			"top": "mix(ACCENT,#ffffff,0.35)",
			"bottom": "ACCENT",
			"glow_top": 1.0,
			"glow": "ACCENT"
		}
	},
