+//! Ashfall patch: records every building shell and every furnished interior unit so the Ashfall
+//! post-processor (a Fabric mod) can place loot, zones and spawns by the use Arnis furnished,
+//! without re-deriving Arnis's classification or projection. Written to
+//! `<world>/ashfall/buildings.json` just before the world is saved.
+//!
+//! Cell sets are run-length encoded as `[z, x_start, x_end]` rows (inclusive). A building
+//! processed in several tiles is recorded once per tile; the reader merges records by OSM id.
+
+use serde::Serialize;
+use std::collections::{BTreeMap, HashMap};
+use std::path::Path;
+use std::sync::Mutex;
+
+/// Tags worth keeping for classification and naming downstream.
+const KEPT_TAGS: &[&str] = &[
+    "building", "name", "amenity", "shop", "healthcare", "office", "tourism", "leisure", "craft",
+    "military", "emergency", "religion", "building:levels", "building:use", "man_made", "ruins",
+];
+
+#[derive(Serialize)]
+struct Shell {
+    id: u64,
+    tags: BTreeMap<String, String>,
+    /// Absolute Y of each floor slab.
+    floors: Vec<i32>,
+    base_y: i32,
+    top_y: i32,
+    rows: Vec<[i32; 3]>,
+}
+
+#[derive(Serialize)]
+struct Unit {
+    id: u64,
+    floor: usize,
+    floor_y: i32,
+    top_y: i32,
+    /// Arnis's `Use`, Debug-formatted: "Home", "Shop(Pharmacy)", "Food(Cafe)", ...
+    #[serde(rename = "use")]
+    use_: String,
+    rows: Vec<[i32; 3]>,
+}
+
+#[derive(Serialize)]
+struct Sidecar<'a> {
+    format: u32,
+    arnis_version: &'a str,
+    shells: &'a [Shell],
+    units: &'a [Unit],
+}
+
+static SHELLS: Mutex<Vec<Shell>> = Mutex::new(Vec::new());
+static UNITS: Mutex<Vec<Unit>> = Mutex::new(Vec::new());
+
+fn rows(cells: &[(i32, i32)]) -> Vec<[i32; 3]> {
+    let mut sorted: Vec<(i32, i32)> = cells.iter().map(|&(x, z)| (z, x)).collect();
+    sorted.sort_unstable();
+    sorted.dedup();
+    let mut out: Vec<[i32; 3]> = Vec::new();
+    for (z, x) in sorted {
+        match out.last_mut() {
+            Some(row) if row[0] == z && row[2] + 1 == x => row[2] = x,
+            _ => out.push([z, x, x]),
+        }
+    }
+    out
+}
+
+pub fn record_shell(
+    id: u64,
+    tags: &HashMap<String, String>,
+    footprint: &[(i32, i32)],
+    floors: &[i32],
+    base_y: i32,
+    top_y: i32,
+) {
+    let kept = KEPT_TAGS
+        .iter()
+        .filter_map(|k| tags.get(*k).map(|v| (k.to_string(), v.clone())))
+        .collect();
+    let shell = Shell { id, tags: kept, floors: floors.to_vec(), base_y, top_y, rows: rows(footprint) };
+    SHELLS.lock().unwrap().push(shell);
+}
+
+pub fn record_unit(id: u64, floor: usize, floor_y: i32, top_y: i32, use_: impl std::fmt::Debug, cells: &[(i32, i32)]) {
+    let unit = Unit { id, floor, floor_y, top_y, use_: format!("{use_:?}"), rows: rows(cells) };
+    UNITS.lock().unwrap().push(unit);
+}
+
+pub fn write(world_dir: &Path) -> std::io::Result<()> {
+    let shells = SHELLS.lock().unwrap();
+    let units = UNITS.lock().unwrap();
+    let dir = world_dir.join("ashfall");
+    std::fs::create_dir_all(&dir)?;
+    let sidecar = Sidecar { format: 1, arnis_version: env!("CARGO_PKG_VERSION"), shells: &shells, units: &units };
+    let file = std::io::BufWriter::new(std::fs::File::create(dir.join("buildings.json"))?);
+    serde_json::to_writer(file, &sidecar)?;
+    println!("Ashfall sidecar: {} shells, {} units", shells.len(), units.len());
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::rows;
+
+    #[test]
+    fn rows_merge_contiguous_runs() {
+        let cells = [(1, 0), (2, 0), (3, 0), (5, 0), (1, 1)];
+        assert_eq!(rows(&cells), vec![[0, 1, 3], [0, 5, 5], [1, 1, 1]]);
+    }
+}
